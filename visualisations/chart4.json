{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Online Spending Across Australian States and Territories (2025)",
    "subtitle": "Labels show state abbreviation and online spend in billions",
    "fontSize": 20
  },

  "width": 850,
  "height": 520,

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 850,
    "translate": [425, 260]
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_border.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2016_AUST"
        }
      },

      "transform": [
        {
          "lookup": "properties.STE_NAME16",
          "from": {
            "data": {
              "url": "data/chart4_state_online_spending.csv"
            },
            "key": "state",
            "fields": [
              "state_abbr",
              "online_spend_billion",
              "yoy_growth"
            ]
          }
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "color": {
          "field": "online_spend_billion",
          "type": "quantitative",
          "title": "Online spend ($b)",
          "scale": {
            "scheme": "blues"
          }
        },

        "tooltip": [
          {
            "field": "properties.STE_NAME16",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "online_spend_billion",
            "type": "quantitative",
            "title": "Online spend ($b)"
          },
          {
            "field": "yoy_growth",
            "type": "quantitative",
            "title": "YoY growth (%)"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/chart4_state_online_spending.csv"
      },

      "transform": [
        {
          "filter": "isValid(datum.label_lon) && isValid(datum.label_lat)"
        },
        {
          "calculate": "datum.state_abbr + ' ($' + datum.online_spend_billion + 'B)'",
          "as": "label"
        }
      ],

      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "align": "center",
        "baseline": "middle"
      },

      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "value": "black"
        }
      }
    }
  ]
}