{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Online Shopping Reasons in Australia"
  },

  "width": 600,
  "height": 600,

  "data": {
    "url": "data/chart11_online_purchase_drivers_radar_2021_2023.csv"
  },

  "params": [
    {
        "name": "selected_year",
        "value": "All",
        "bind": {
        "input": "select",
        "options": ["All", 2021, 2022, 2023],
        "name": "Highlight year: "
        }
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [-90, 90]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [-90, 90]
          }
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "color": {
          "field": "year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "range": ["#8ECAE6", "#FFB703", "#D62828"]
          }
        },
        "opacity": {
        "condition": {
            "test": "selected_year == 'All' || datum.year == selected_year",
            "value": 1
        },
        "value": 0.12
        },
        "detail": {
          "field": "year"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "factor",
            "title": "Reason"
          },
          {
            "field": "percentage",
            "title": "Shoppers (%)"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year == 2023 && datum.row_type == 'point'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "factor"
        },
        "color": {
          "value": "black"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "right",
      "titleFontSize": 14,
      "labelFontSize": 12
    }
  }
}