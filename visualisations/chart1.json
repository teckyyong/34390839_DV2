{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Growth of Retail Categories in Australia",
    "fontSize": 20
  },

  "width": 700,

  "height": 400,

  "data": {
    "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/stocks.csv"
  },

  "mark": {
    "type": "line",
    "point": true
  },

  "encoding": {

    "x": {
      "field": "date",
      "type": "temporal",
      "title": "Year"
    },

    "y": {
      "field": "price",
      "type": "quantitative",
      "title": "Value"
    },

    "color": {
      "field": "symbol",
      "type": "nominal",
      "title": "Category"
    },

    "tooltip": [

      {
        "field": "date",
        "type": "temporal"
      },

      {
        "field": "symbol",
        "type": "nominal"
      },

      {
        "field": "price",
        "type": "quantitative"
      }

    ]

  }

}