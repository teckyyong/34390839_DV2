{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Social Media Platforms Used to Discover Products",
    "subtitle": "Percentage using each platform to search for new products"
  },

  "width": 520,
  "height": 260,

  "data": {
    "url": "data/chart10_social_media_product_discovery.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "platform",
          "type": "nominal",
          "title": "Platform"
        },

        "y": {
          "field": "age_group",
          "type": "nominal",
          "title": "Age Group",
          "sort": [
            "Gen Z",
            "Millennials",
            "Older Generations"
          ]
        },

        "color": {
          "field": "percentage",
          "type": "quantitative",
          "title": "% Using Platform",
          "scale": {
            "scheme": "blues"
          }
        },

        "tooltip": [
          {"field": "age_group", "title": "Age Group"},
          {"field": "platform", "title": "Platform"},
          {"field": "percentage", "title": "Percentage (%)"}
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontWeight": "bold",
        "fontSize": 14
      },

      "encoding": {
        "x": {
          "field": "platform",
          "type": "nominal"
        },

        "y": {
          "field": "age_group",
          "type": "nominal",
          "sort": [
            "Gen Z",
            "Millennials",
            "Older Generations"
          ]
        },

        "text": {
          "field": "percentage"
        },

        "color": {
          "condition": {
            "test": "datum.percentage > 60",
            "value": "white"
          },
          "value": "black"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}