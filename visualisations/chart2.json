{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Online Spend by Category in Australia, 2025",
    "fontSize": 20
  },

  "data": {
    "url": "data/chart2_online_category_spend_2024_2025.csv"
  },

  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],

  "width": 420,
  "height": 350,

  "params": [
    {
      "name": "category_highlight",
      "select": {
        "type": "point",
        "fields": ["category"]
      },
      "bind": "legend"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 6,
    "cornerRadiusTopRight": 6
  },

  "encoding": {

    "x": {
      "field": "category",
      "type": "nominal",
      "sort": "-y",
      "title": "Category",
      "axis": {
        "labelAngle": -35
      }
    },

    "y": {
      "field": "online_spend_billion",
      "type": "quantitative",
      "title": "Online spend ($ billions)"
    },

    "color": {
      "field": "category",
      "type": "nominal",
      "legend": null
    },

    "opacity": {
      "condition": {
        "param": "category_highlight",
        "value": 1
      },
      "value": 0.25
    },

    "tooltip": [
      {
        "field": "category"
      },
      {
        "field": "online_spend_billion",
        "title": "Online spend ($b)"
      }
    ]
  }
}