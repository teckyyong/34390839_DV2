{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": "Online Spend by Category in Australia, 2025",

  "data": {
    "url": "data/chart2_online_category_spend_2024_2025.csv"
  },

  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],

  "width": 800,
  "height": 420,

  "params": [
    {
      "name": "category_highlight",
      "select": {
        "type": "point",
        "fields": ["category"]
      },
      "bind": "legend"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 6
  },

  "encoding": {
    "x": {
      "field": "online_spend_billion",
      "type": "quantitative",
      "title": "Online spend ($ billions)"
    },

    "y": {
      "field": "category",
      "type": "nominal",
      "sort": "-x",
      "title": "Category"
    },

    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Category"
    },

    "opacity": {
      "condition": {
        "param": "category_highlight",
        "value": 1
      },
      "value": 0.25
    },

    "tooltip": [
      {
        "field": "category",
        "type": "nominal",
        "title": "Category"
      },
      {
        "field": "online_spend_billion",
        "type": "quantitative",
        "title": "Online spend ($b)",
        "format": ".1f"
      }
    ]
  }
}