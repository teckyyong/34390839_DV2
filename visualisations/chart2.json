{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Revenue generated through online spending",
    "fontSize": 20
  },

  "data": {
    "url": "data/chart2_online_category_spend_2024_2025.csv"
  },

  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],

  "width": 350,
  "height": 350,

  "params": [
    {
      "name": "category_highlight",
      "select": {
        "type": "point",
        "fields": ["category"]
      },
      "bind": "legend"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 6,
    "cornerRadiusTopRight": 6
  },

  "encoding": {

    "x": {
      "field": "category",
      "type": "nominal",
      "sort": "-y",
      "title": "Category",
      "axis": {
        "labelAngle": -35
      }
    },

    "y": {
      "field": "online_spend_billion",
      "type": "quantitative",
      "title": "Online spend ($ billions)"
    },

    "color": {
  "field": "category",
  "type": "nominal",
  "legend": null,
  "scale": {
    "domain": [
      "Books, stationery & multimedia",
      "Consumer electronics",
      "Department stores",
      "Fashion & apparel",
      "Food & liquor",
      "Health & beauty",
      "Hobbies & recreation goods",
      "Home & garden",
      "Online marketplaces"
    ],
    "range": [
      "#4E79A7",
      "#F28E2B",
      "#B07AA1",
      "#76B7B2",
      "#59A14F",
      "#EDC948",
      "#9C755F",
      "#FF9DA7",
      "#BAB0AC"
    ]
  }
},

    "opacity": {
      "condition": {
        "param": "category_highlight",
        "value": 1
      },
      "value": 0.25
    },

    "tooltip": [
      {
        "field": "category"
      },
      {
        "field": "online_spend_billion",
        "title": "Online spend ($b)"
      }
    ]
  }
}