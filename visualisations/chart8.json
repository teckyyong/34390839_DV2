{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Online spending, growth and share"
  },

  "data": {
    "url": "data/chart8_generation_spending_metrics.csv"
  },

  "width": 110,
  "height": 260,

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 5,
    "cornerRadiusTopRight": 5
  },

  "encoding": {
    "x": {
      "field": "generation",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelAngle": -35
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": null
    },
    "color": {
  "field": "generation",
  "type": "nominal",
  "legend": null,
  "scale": {
    "domain": [
      "Baby Boomers",
      "Builders",
      "Gen X",
      "Gen Z",
      "Millennials"
    ],
    "range": [
      "#4E79A7",
      "#F28E2B",
      "#B07AA1",
      "#76B7B2",
      "#59A14F"
    ]
  }
},
    "column": {
      "field": "metric",
      "type": "nominal",
      "title": null
    },
    "tooltip": [
      {"field": "generation"},
      {"field": "metric"},
      {"field": "value"}
    ]
  }
}